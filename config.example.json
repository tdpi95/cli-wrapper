{
  "version": 2,
  "settings": {
    "apiKey": "",
    "apiPort": 8869,
    "cliTimeoutMs": 300000,
    "cliWorkdir": "./.cli-wrapper-workspace",
    "logCaptureContent": true,
    "logFilePath": null,
    "codexBypassProxyForOpenAI": false,
    "codexUseWarmPool": false,
    "codexPoolSize": 2
  },
  "models": [
    {
      "id": "claude-sonnet-5",
      "provider": "claude",
      "cliModel": "sonnet",
      "description": "Claude Sonnet via the Claude Code CLI"
    },
    {
      "id": "claude-opus-5",
      "provider": "claude",
      "cliModel": "opus",
      "reasoningEffort": "high",
      "allowReasoningEffortOverride": true,
      "description": "Claude Opus via the Claude Code CLI, extended thinking on by default (override with the request's reasoning_effort field)"
    },
    {
      "id": "claude-sonnet-5-websearch",
      "provider": "claude",
      "cliModel": "sonnet",
      "enableWebSearch": true,
      "description": "Claude Sonnet with the built-in WebSearch tool enabled"
    },
    {
      "id": "gpt-5.5",
      "provider": "codex",
      "cliModel": "gpt-5.5",
      "description": "GPT-5.5 via the Codex CLI"
    },
    {
      "id": "gpt-5.5-websearch",
      "provider": "codex",
      "cliModel": "gpt-5.5",
      "enableWebSearch": true,
      "description": "GPT-5.5 via the Codex CLI with its built-in web_search tool enabled"
    }
  ]
}
