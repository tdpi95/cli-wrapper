# Only two settings are env-only now — everything else (the API key, CLI
# timeout, working directory, activity-log capture/persistence) lives in
# config.json and is editable at http://localhost:8868/settings, no restart
# needed. See README.md's "Configuration" section.

# Where config.json lives. Rarely needs changing.
CONFIG_PATH=./config.json

# Optional: overrides config.json's settings.port for this run (useful for
# containers/process managers that inject PORT themselves). Leave unset to
# use the port configured on the settings page.
# PORT=8868
