WRAPPER_API_KEY=change-me-to-a-long-random-string
PORT=8787
CLI_TIMEOUT_MS=120000
CONFIG_PATH=./config.json
# Set to false to stop the activity log (see /settings) from storing full
# prompt/response text — only metadata (model, status, duration, tokens) is
# kept. Defaults to true.
LOG_CAPTURE_CONTENT=true
# Uncomment to persist the last 200 activity-log entries to a JSON file so
# they survive a restart. Unset (default) = in-memory only, nothing written
# to disk. If LOG_CAPTURE_CONTENT is also on, this file will contain full
# prompt/response text — keep it out of version control (see .gitignore).
# LOG_FILE_PATH=./activity-log.json
