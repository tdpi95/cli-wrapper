# Only three settings are env-only now — everything else (the API key, CLI
# timeout, working directory, activity-log capture/persistence, API port)
# lives in config.json and is editable at http://localhost:8868/settings, no
# restart needed. See README.md's "Configuration" section.
#
# The settings surface and the OpenAI-compatible API listen on two separate
# ports, by design (see AGENTS.md's "Two ports, by design") — settings on
# SETTINGS_PORT below, the API on config.json's settings.apiPort (or PORT
# below, to override it for this run only).

# Where config.json lives. Rarely needs changing. If unset, defaults to
# ./config.json when one already exists there and looks valid, otherwise
# falls back to ~/.cli-wrapper/config.json (see AGENTS.md's "Config path
# defaults to the home directory" — avoids scattering a fresh config.json
# wherever a globally-installed cli-wrapper happens to be run from).
# CONFIG_PATH=./config.json

# Port the settings surface (/settings, /api/settings/*) listens on. Not
# stored in config.json on purpose — see AGENTS.md.
# SETTINGS_PORT=8868

# Optional: overrides config.json's settings.apiPort for this run (useful for
# containers/process managers that inject PORT themselves). Leave unset to
# use the API port configured on the settings page. Never affects
# SETTINGS_PORT above.
# PORT=8869
