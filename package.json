{
  "name": "cli-wrapper",
  "version": "0.1.1",
  "description": "OpenAI-compatible HTTP API that wraps the claude and codex CLIs as chat-only subprocesses",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "cli-wrapper": "./bin/cli-wrapper.js"
  },
  "files": [
    "bin",
    "dist",
    "public",
    "config.example.json",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
